<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Citizen Portal — SurakshaNER</title>

  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/citizen/citizen.css">

  <!-- Fonts: Space Grotesk (headings), Source Sans 3 (body/UI), JetBrains Mono (eyebrows/data) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Source+Sans+3:wght@400;500;600;700&family=Archivo:wght@600;700&display=swap"
  >

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#16281f">
</head>

<body class="page-home">

  <script>
    window.NAV_BASE = '../';
    window.NAV_CURRENT = 'citizen';
  </script>

  <!-- =========================
       SHARED NAVIGATION
  ========================== -->
  <div id="site-navbar"></div>

  <!-- Active emergency / system alert banner -->
  <div
    id="citizen-alert-banner"
    class="citizen-alert-banner"
    aria-live="assertive"
  ></div>


  <!-- =========================
       CITIZEN HERO
  ========================== -->
  <section class="hero citizen-hero">

    <div class="hero-inner">

      <div class="hero-main">

        <div class="hero-eyebrow">
          CITIZEN PORTAL
        </div>

        <h1 class="hero-title">
          Report an emergency or send an SOS
        </h1>

      

        <div class="hero-ctas">

          <div class="hero-ctas-group hero-ctas-sos">

            <button
              type="button"
              id="in-danger-btn"
              class="in-danger-btn"
            >
              <span class="ui-icon" aria-hidden="true">
                <!-- icon: sos / broadcast -->
              </span>

              SOS
            </button>

            <div>
              <p>
              Your location is sent automatically
              <br>
              when you click the SOS button.
            </p>
            </div>
            

          </div>

          <div class="hero-ctas-group hero-ctas-secondary">

            <button
              type="button"
              class="cta-primary open-emergency-modal"
            >
              <span class="ui-icon" aria-hidden="true">
                <!-- icon: shield / emergency-services -->
              </span>

              Emergency Services
            </button>

            <a
              href="#lostFoundSection"
              class="cta-lostfound"
            >
              <span class="ui-icon" aria-hidden="true">
                <!-- icon: search / lost-and-found -->
              </span>

              Lost &amp; Found
            </a>

          </div>

          

        </div>

      </div>


      <!-- Decorative regional identity block — replace hero-decor-art with provided artwork -->
      <div class="hero-decor" aria-hidden="true">

        <div class="hero-decor-caption">
          <span>SAFER COMMUNITIES</span>
          <span>STRONGER NORTH EAST</span>
        </div>

        <div class="hero-decor-rule"></div>

        <div class="hero-decor-art">
          <!-- artwork: mountain range motif -->
        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       MAIN CITIZEN CONTENT
  ========================== -->
  <main class="citizen-content">


    <!-- =========================
         ALERT AUTHORITIES
         + ANNOUNCEMENTS
    ========================== -->
    <div class="citizen-grid">


      <!-- ALERT AUTHORITIES -->
      <section class="panel citizen-panel citizen-sos-panel">

        <div class="panel-heading">

          <div class="panel-heading-text">

            <span class="panel-icon" aria-hidden="true">
              <!-- icon: shield -->
            </span>

            <div>
              <div class="panel-eyebrow">
                EMERGENCY
              </div>

              <h2>
                Alert Authorities
              </h2>
            </div>

          </div>

          <div class="panel-heading-note">
            Help us reach you faster.
          </div>

        </div>


        <div class="form-group">

          <label for="victimCount">
            Number of people needing help
          </label>

          <input
            type="number"
            id="victimCount"
            value="1"
            min="1"
            inputmode="numeric"
          >

        </div>


        <div class="form-group">

          <label for="vulnerability">
            Anyone elderly, disabled, or needing medical attention?
          </label>

          <select id="vulnerability">
            <option value="none">No</option>
            <option value="elderly">Elderly person</option>
            <option value="disabled">Person with disability</option>
            <option value="medical">Medical emergency</option>
            <option value="child">Young child</option>
          </select>

        </div>


        <button
          type="button"
          class="sos-btn"
          id="sosBtn"
          onclick="sendSOS()"
        >

          <span class="ui-icon" aria-hidden="true">
            <!-- icon: send / paper-plane -->
          </span>

          SEND ALERT

        </button>


        <div
          id="status"
          class="citizen-status"
          aria-live="polite"
        ></div>

        <p class="panel-footnote">
          Your location will be shared automatically with emergency responders.
        </p>

      </section>


      <!-- =========================
           ANNOUNCEMENTS
      ========================== -->
      <section class="panel citizen-panel citizen-announcements-panel">

        <div class="panel-heading">

          <div class="panel-heading-text">

            <span class="panel-icon" aria-hidden="true">
              <!-- icon: megaphone -->
            </span>

            <div>
              <div class="panel-eyebrow">
                LOCAL INFORMATION
              </div>

              <h2>
                Announcements
              </h2>
            </div>

          </div>

          <div class="panel-heading-note">
            Stay informed. Stay safe.
          </div>

        </div>


        <div id="announcements">
          Loading...
        </div>

        <div
          class="announcements-pagination"
          id="announcementsPagination"
          hidden
        >

          <button
            type="button"
            class="pagination-btn"
            id="announcementsPrev"
            aria-label="Previous announcements"
          >
            &lsaquo;
          </button>

          <span
            class="pagination-status"
            id="announcementsPageStatus"
          >
            1 / 1
          </span>

          <button
            type="button"
            class="pagination-btn"
            id="announcementsNext"
            aria-label="Next announcements"
          >
            &rsaquo;
          </button>

        </div>

      </section>

    </div>


    <!-- =========================
         HAZARD REPORT
    ========================== -->
    <div class="citizen-grid citizen-grid-single">

      <section
        class="panel citizen-panel hazard-panel"
        id="reportHazardSection"
      >

        <div class="panel-heading">

          <div class="panel-heading-text">

            <span class="panel-icon" aria-hidden="true">
              <!-- icon: warning-triangle -->
            </span>

            <div>
              <div class="panel-eyebrow">
                FIELD REPORT
              </div>

              <h2>
                Report a Hazard
              </h2>
            </div>

          </div>

          <div class="panel-heading-note">
            Help keep your community safe.
          </div>

        </div>


        <!-- Hazard type -->
        <div class="form-group">

          <label>
            What are you seeing?
          </label>


          <div
            id="hazardButtons"
            class="hazard-buttons"
          >


            <!-- CRACK -->
            <button
              type="button"
              class="hazard-btn"
              data-hazard="crack"
            >

              <span class="ui-icon" aria-hidden="true">
                <!-- icon: crack -->
              </span>

              <span>
                Crack
              </span>

            </button>


            <!-- DEBRIS -->
            <button
              type="button"
              class="hazard-btn"
              data-hazard="debris"
            >

              <span class="ui-icon" aria-hidden="true">
                <!-- icon: debris -->
              </span>

              <span>
                Debris
              </span>

            </button>


            <!-- ROAD BLOCKED -->
            <button
              type="button"
              class="hazard-btn"
              data-hazard="roadblock"
            >

              <span class="ui-icon" aria-hidden="true">
                <!-- icon: road-blocked -->
              </span>

              <span>
                Road Blocked
              </span>

            </button>


            <!-- OTHER -->
            <button
              type="button"
              class="hazard-btn"
              data-hazard="other"
            >

              <span class="ui-icon" aria-hidden="true">
                <!-- icon: other / more -->
              </span>

              <span>
                Other
              </span>

            </button>

          </div>

        </div>


        <!-- Media + Description -->
        <div class="hazard-fields-row">

          <div class="form-group">

            <label for="mediaFile">
              Photo or video
            </label>

            <div class="file-field">

              <label for="mediaFile" class="file-field-trigger">

                <span class="ui-icon" aria-hidden="true">
                  <!-- icon: upload -->
                </span>

                <span>Choose photo or video</span>

              </label>

              <input
                type="file"
                id="mediaFile"
                accept="image/*,video/*"
                capture="environment"
              >

              <span class="file-field-hint">JPG, PNG, MP4 (Max 15MB)</span>

            </div>

          </div>


          <div class="form-group">

            <label for="reportDescription">
              Additional details
              <span class="field-optional">Optional</span>
            </label>

            <textarea
              id="reportDescription"
              placeholder="Describe the location or hazard..."
              rows="4"
            ></textarea>

          </div>

        </div>


        <!-- Submit -->
        <div class="hazard-submit-row">

          <button
            type="button"
            class="post-btn"
            id="reportBtn"
            onclick="submitReport()"
          >

            <span class="ui-icon" aria-hidden="true">
              <!-- icon: send / paper-plane -->
            </span>

            Submit Hazard Report

          </button>

          <span class="hazard-submit-note">
            <span class="ui-icon" aria-hidden="true">
              <!-- icon: info-circle -->
            </span>
            Your report will be shared with the relevant authorities.
          </span>

          <div
            id="reportStatus"
            class="citizen-status hazard-status"
            aria-live="polite"
          ></div>

        </div>

      </section>

    </div>

  </main>


  <!-- =========================
       DOST ASSISTANCE
  ========================== -->

  <aside
    id="dost-panel"
    class="dost-panel is-closed"
    aria-label="DOST assistance panel"
    aria-hidden="true"
  >

    <div class="dost-header">

      <div>

        <div class="dost-kicker">
          ASSISTANCE
        </div>

        <h2>
          DOST
        </h2>

      </div>


      <button
        id="dost-close"
        class="dost-close"
        type="button"
        aria-label="Close DOST"
      >
        <span aria-hidden="true">
          &times;
        </span>
      </button>

    </div>


    <div class="dost-body">

      <div class="dost-welcome">
        Ask for disaster-safety guidance or help using this portal.
      </div>


      <!-- Suggested questions -->
      <section class="dost-section">

        <h3>
          Suggested questions
        </h3>


        <div class="dost-suggestions">

          <button
            type="button"
            data-dost-question="What should I do during a landslide?"
          >
            What should I do during a landslide?
          </button>


          <button
            type="button"
            data-dost-question="Where is the nearest shelter?"
          >
            Where is the nearest shelter?
          </button>


          <button
            type="button"
            data-dost-question="How do I report a hazard?"
          >
            How do I report a hazard?
          </button>

        </div>

      </section>


      <!-- Quick actions -->
      <section class="dost-section">

        <h3>
          Quick actions
        </h3>


        <div class="dost-actions">

          <button
            type="button"
            class="dost-action"
            id="dost-help"
          >
            Call for Help
          </button>


          <button
            type="button"
            class="dost-action dost-action-sos"
            id="dost-sos"
          >
            Send SOS
          </button>


          <button
            type="button"
            class="dost-action"
            id="dost-ask"
          >
            Ask a Question
          </button>

        </div>

      </section>


      <!-- Messages -->
      <div
        id="dost-messages"
        class="dost-messages"
        aria-live="polite"
      ></div>

    </div>


    <!-- DOST input -->
    <form
      id="dost-form"
      class="dost-input-row"
    >

      <label
        for="dost-input"
        class="sr-only"
      >
        Ask DOST a question
      </label>


      <input
        id="dost-input"
        type="text"
        placeholder="Ask a question..."
        autocomplete="off"
      >


      <button
        type="submit"
        aria-label="Send question"
      >
        Send
      </button>

    </form>

  </aside>


  <!-- =========================
       DOST LAUNCHER
  ========================== -->
  <button
    id="dost-open"
    class="dost-open"
    type="button"
    aria-label="Open DOST assistance"
    aria-expanded="false"
  >
    <span class="ui-icon" aria-hidden="true">
      <!-- icon: chat-bubble -->
    </span>

    DOST
  </button>


  <!-- =========================
       SHARED / CITIZEN SCRIPTS
  ========================== -->

  <script src="/translations.js"></script>
  <script src="/offline-queue.js"></script>
  <script src="/navbar.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/citizen/citizen.js"></script>
  <script src="/citizen/citizen-announcements-pagination.js"></script>


  <!-- =========================
       DOST UI LOGIC
  ========================== -->
  <script>
    (function () {

      const panel =
        document.getElementById('dost-panel');

      const close =
        document.getElementById('dost-close');

      const open =
        document.getElementById('dost-open');

      const form =
        document.getElementById('dost-form');

      const input =
        document.getElementById('dost-input');

      const messages =
        document.getElementById('dost-messages');


      function addMessage(text, who) {

        const item =
          document.createElement('div');

        item.className =
          'dost-message ' + (who || 'bot');

        item.textContent = text;

        messages.appendChild(item);

        messages.scrollTop =
          messages.scrollHeight;
      }


      function ask(question) {

        if (!question) return;

        addMessage(question, 'user');

        const lowerQuestion =
          question.toLowerCase();


        const answer =
          lowerQuestion.includes('landslide')
            ? 'Move away from slopes and unstable ground, follow official alerts, and avoid crossing debris.'

            : lowerQuestion.includes('shelter')
              ? 'Demo response: nearby shelters will appear here once location services and the rescue database are connected.'

              : lowerQuestion.includes('hazard')
                ? 'Use the Report a Hazard section on this page to submit details and media.'

                : 'This is a demo response from DOST. A live assistance service will provide verified guidance here.';


        setTimeout(function () {

          addMessage(
            answer,
            'bot'
          );

        }, 250);
      }


      function openDost() {

        panel.classList.remove(
          'is-closed'
        );

        panel.setAttribute(
          'aria-hidden',
          'false'
        );

        open.setAttribute(
          'aria-expanded',
          'true'
        );

        input.focus();
      }


      function closeDost() {

        panel.classList.add(
          'is-closed'
        );

        panel.setAttribute(
          'aria-hidden',
          'true'
        );

        open.setAttribute(
          'aria-expanded',
          'false'
        );
      }


      close.addEventListener(
        'click',
        closeDost
      );


      open.addEventListener(
        'click',
        openDost
      );


      document
        .querySelectorAll('[data-dost-question]')
        .forEach(function (button) {

          button.addEventListener(
            'click',
            function () {

              ask(
                button.dataset.dostQuestion
              );

            }
          );

        });


      form.addEventListener(
        'submit',
        function (event) {

          event.preventDefault();

          const value =
            input.value.trim();

          input.value = '';

          ask(value);

        }
      );


      document
        .getElementById('dost-help')
        .addEventListener(
          'click',
          function () {

            addMessage(
              'Demo action: connecting you to emergency assistance.',
              'bot'
            );

          }
        );


      document
        .getElementById('dost-sos')
        .addEventListener(
          'click',
          function () {

            addMessage(
              'Demo action: SOS prepared. Use the main SEND ALERT button to submit the real alert.',
              'bot'
            );

            document
              .getElementById('sosBtn')
              ?.focus();

          }
        );


      document
        .getElementById('dost-ask')
        .addEventListener(
          'click',
          function () {

            input.focus();

          }
        );

    })();
  </script>


  <!-- =========================
       SERVICE WORKER
  ========================== -->
  <script>

    if ('serviceWorker' in navigator) {

      navigator.serviceWorker
        .register('/service-worker.js')

        .then(function () {

          console.log(
            'Service worker registered'
          );

          if (navigator.onLine) {
            flushSOSQueue();
          }

        });

    }

  </script>

</body>
</html>